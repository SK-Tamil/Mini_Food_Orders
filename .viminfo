	.counter {
	  font-size: 16px;
	  padding: 5px 10px;
	  border-radius: 5px;
	  color: var(--accent);
	  background: var(--accent-bg);
	  border: 2px solid transparent;
	  transition: border-color 0.3s;
	  margin-bottom: 24px;
	
	  &:hover {
	    border-color: var(--accent-border);
	  }
	  &:focus-visible {
	    outline: 2px solid var(--accent);
	    outline-offset: 2px;
	  }
	}
	
	.hero {
	  position: relative;
	
	  .base,
	  .framework,
	  .vite {
	    inset-inline: 0;
	    margin: 0 auto;
	  }
	
	  .base {
	    width: 170px;
	    position: relative;
	    z-index: 0;
	  }
	
	  .framework,
	  .vite {
	    position: absolute;
	  }
	
	  .framework {
	    z-index: 1;
	    top: 34px;
	    height: 28px;
	    transform: perspective(2000px) rotateZ(300deg) rotateX(44deg) rotateY(39deg)
	      scale(1.4);
	  }
	
	  .vite {
	    z-index: 0;
